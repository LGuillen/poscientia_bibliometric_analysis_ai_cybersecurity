	title = {AnoMili: Spoofing Hardening and Explainable Anomaly Detection for the 1553 Military Avionic Bus},
	year = {2024},
	journal = {IEEE Transactions on Aerospace and Electronic Systems},
	volume = {60},
	number = {6},
	pages = {7738 - 7753},
	doi = {10.1109/TAES.2024.3418757},
	url = {https://www.scopus.com/pages/publications/85197486757?origin=resultslist},
	affiliations = {Ben-Gurion University of the Negev, Faculty of Information Systems Engineering, Be'er Sheva, 8410501, Israel},
	abstract = {MIL-STD-1553, a standard that defines a communication bus for interconnected devices, is widely used in military and aerospace avionic platforms. Due to its lack of security mechanisms, MIL-STD-1553 is exposed to cyber threats. The methods previously proposed to address these threats are very limited, resulting in the need for more advanced techniques. Inspired by the defense in depth principle, we propose AnoMili, a protection system for the MIL-STD-1553 bus, which consists of: 1) a physical intrusion detection mechanism that detects unauthorized devices connected to the 1553 bus, even if they are passive (sniffing); 2) a device fingerprinting mechanism that protects against spoofing attacks (two approaches are proposed: prevention and detection); 3) a context-based anomaly detection mechanism; and 4) an anomaly explanation engine responsible for explaining the detected anomalies in real time. To the best of our knowledge, this is the first study in the transportation domain to design a real-time mechanism that produces human-actionable insights regarding the anomalies detected. We evaluate AnoMili's effectiveness and practicality in two real 1553 hardware-based test beds. The effectiveness of the anomaly explanation engine is also demonstrated. All the detection and prevention mechanisms employed had high detection rates (over 99.45%) with low false positive rates. The context-based anomaly detection mechanism obtained perfect results when evaluated on a dataset used in prior work.  © 1965-2011 IEEE.},
	author_keywords = {Anomaly detection; avionics security; deep learning; explainable artificial intelligence; intrusion detection; MIL-STD-1553},
	keywords = {Avionics; Buses; Cybersecurity; Deep learning; E-learning; Engines; Interactive computer systems; Real time systems; Aerospace electronics; Anomaly detection; Avionic security; Deep learning; Explainable artificial intelligence; Intrusion-Detection; MIL-STD-1553; Military standard; Real - Time system; Security; Intrusion detection},
	correspondence_address = {E. Levy; Ben-Gurion University of the Negev, Faculty of Information Systems Engineering, Be'er Sheva, 8410501, Israel; email: elevy@post.bgu.ac.il},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {00189251},
