@ARTICLE{Vu Bui2025,
	author = {Vu Bui, Luong},
	title = {Legally-aware AI moderation in Vietnam: A cybersecurity law-compliant framework for platform governance},
	year = {2025},
	journal = {Journal of Economic Criminology},
	volume = {10},
	pages = {},
	doi = {10.1016/j.jeconc.2025.100193},
