@ARTICLE{Mahmud Sujon2025104992,
	author = {Mahmud Sujon, Khaled and Binti Hassan, Rohayanti and Abdullah-Al-Wadud, M. and Uddin, Jia},
	title = {OPTISTACK: A Hybrid Ensemble Learning and XAI-Based Approach for Malware Detection in Compressed Files},
	year = {2025},
