@ARTICLE{Reis2025153244,
	author = {Reis, Manuel J. Cabral S.},
	title = {Scalable Intrusion Detection in IoT Networks Via Property Testing and Federated Edge AI},
	year = {2025},
	journal = {IEEE Access},
