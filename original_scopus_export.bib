@ARTICLE{Omopariola2024132,
	author = {Omopariola, Moses Kolawole},
	title = {AI‑ENHANCED THREAT DETECTION FOR NATIONAL-SCALE CLOUD NETWORKS: FRAMEWORKS, APPLICATIONS, AND CASE STUDIES},
	year = {2024},
	journal = {Social Science Forum},
	volume = {8},
	number = {9},
