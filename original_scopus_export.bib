	language = {English},
	abbrev_source_title = {J. Homeland Secur. Emerg. Manage.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Hybrid Gold Open Access}
