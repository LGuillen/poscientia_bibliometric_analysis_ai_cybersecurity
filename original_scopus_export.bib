@ARTICLE{Mowri2023,
	author = {Mowri, Rawshan Ara and Siddula, Madhuri and Roy, Kaushik},
	title = {Is iterative feature selection technique efficient enough? A comparative performance analysis of RFECV feature selection technique in ransomware classification using SHAP},
	year = {2023},
	journal = {Discover Internet of Things},
	volume = {3},
