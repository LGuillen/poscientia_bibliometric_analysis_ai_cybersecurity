@ARTICLE{Munilla2026,
	author = {Munilla, Jorge and Khammas, Rana M.},
	title = {Evaluation of Explainable Artificial Intelligence in IoT Intrusion Detection Systems Under DeepFool Adversarial Conditions},
	year = {2026},
	journal = {Sensors},
	volume = {26},
	number = {10},
	pages = {},
	doi = {10.3390/s26102924},
	url = {https://www.scopus.com/pages/publications/105040066777?origin=resultslist},
	affiliations = {Department of Communication Engineering, E.T.S.I. de Telecomunicación, Universidad de Málaga, Campus de Teatinos, Málaga, 29190, Spain; Scientific Research Commission, Baghdad, 10070, Iraq},
	abstract = {As IoT systems complexity grows, transparent and trustworthy machine-learning intrusion detection systems are crucial. Post hoc explainable AI methods, such as SHAP and LIME, are the most widely used ways to explain how models work, but the degree to which these methods are robust to adversarial conditioning is understudied. In this paper, we propose to create a unified system of evaluating explanation fidelity by using three metrics: sparsity, completeness, and robustness based on minimally distorting DeepFool input perturbations. Our study benchmarks SHAP and LIME across three datasets (BoT-IoT, Edge-IIoT, and N-BaIoT) using four classifiers: CNN, DNN, LSTM, and RF. Our results demonstrate a consistent trade-off: SHAP achieves stronger feature alignment and higher completeness under attack, whereas LIME exhibits greater rank stability in terms of top-k feature overlap. However, LIME also produces more spurious attributions and offers less explanatory power than SHAP, especially in the presence of synthetic features. Our findings reveal that high model accuracy does not guarantee that the provided explanation is also high-fidelity. This investigation highlights the necessity for robustness-aware XAI in cybersecurity and provides reproducible parameters to guide the adoption of XAI in adversarial environments. © 2026 by the authors.},
	author_keywords = {completeness; DeepFool algorithm; explainable artificial intelligence; intrusion detection systems; IoT; LIME; robustness; SHAP; sparsity},
