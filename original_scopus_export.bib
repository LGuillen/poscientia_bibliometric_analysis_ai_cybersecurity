	title = {AVI-SHIELD: An Explainable TinyML Cross-Platform Threat Detection Framework for Aviation Mobile Security},
	year = {2026},
	journal = {Information (Switzerland)},
	volume = {17},
	number = {1},
	pages = {},
	doi = {10.3390/info17010021},
	url = {https://www.scopus.com/pages/publications/105028575417?origin=resultslist},
	affiliations = {Laboratory of Engineering Sciences, National School of Applied Sciences of Kenitra, Ibn Tofail University, BP 241 University Avenue, Kenitra, 14000, Morocco; Faculty of Business and Information Technology, Ontario Tech University, 2000 Simcoe Street North, Oshawa, L1H 7K4, ON, Canada},
	abstract = {The integration of mobile devices into aviation powering electronic flight bags, maintenance logs, and flight planning tools has created a critical and expanding cyber-attack surface. Security for these systems must be not only effective but also transparent, resource-efficient, and certifiable to meet stringent aviation safety standards. This paper presents AVI-SHIELD, a novel framework for developing high-assurance, on-device threat detection. Our methodology, grounded in the MITRE ATT&CK<sup>®</sup> framework, models credible aviation-specific threats to generate the AviMal-TinyX dataset. We then design and optimize a set of compact, interpretable detection algorithms through quantization and pruning for deployment on resource-constrained hardware. Evaluation demonstrates that AVI-SHIELD achieves 97.2% detection accuracy on AviMal-TinyX while operating with strict resource efficiency (<1.5 MB model size, <35 ms inference time and <0.1 Joules per inference) on both Android and iOS. The framework provides crucial decision transparency through integrated, on-device analysis of detection results, adding a manageable overhead (~120 ms) only upon detection. Its successful deployment on both Android and iOS demonstrates that AVI-SHIELD can provide a uniform security posture across heterogeneous device fleets, a critical requirement for airline operations. This work provides a foundational approach for deploying certifiable, edge-based security that delivers the mandatory offline protection required for safety critical mobile aviation applications. © 2025 by the authors.},
	author_keywords = {aviation cybersecurity; cross-platform development; edge security; explainable AI (XAI); MITRE ATT&CK; mobile malware detection; on-device inference; tiny machine learning (TinyML)},
	keywords = {Air transportation; Android malware; Artificial intelligence; Learning systems; Mobile computing; Network security; Aviation cybersecurity; Cross platform development; Cyber security; Edge security; Explainable AI (XAI); Machine-learning; Malware detection; MITRE ATT&CK; Mobile malware; Mobile malware detection; On-device inference; Tiny machine learning; Mobile security},
	correspondence_address = {Y. Gahi; Laboratory of Engineering Sciences, National School of Applied Sciences of Kenitra, Ibn Tofail University, Kenitra, BP 241 University Avenue, 14000, Morocco; email: gahi.youssef@uit.ac.ma},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
	issn = {20782489},
