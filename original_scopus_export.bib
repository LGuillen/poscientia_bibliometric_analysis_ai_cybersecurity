@ARTICLE{Abbasi2026,
	author = {Abbasi, Asima Akber and Zameer, Aneela and Raja, Muhammad Asif Zahoor},
	title = {FAS-XAI-ZDA: Explainable deep neural networks for zero-day attack detection leveraging feature attention scores},
	year = {2026},
	journal = {Applied Soft Computing},
	volume = {196},
	pages = {},
	doi = {10.1016/j.asoc.2026.115137},
	url = {https://www.scopus.com/pages/publications/105034375668?origin=resultslist},
	affiliations = {Department of Computer & Information Sciences, Pakistan Institute of Engineering & Applied Sciences (PIEAS), Nilore, Islamabad, 45650, Pakistan; Future Technology Research Center, National Yunlin University of Science and Technology, 123 University Road, Section 3, Yunlin, Douliou, 64002, Taiwan},
	abstract = {Zero-day attacks pose a significant challenge to cybersecurity systems due to their unpredictable nature, absence of predefined signatures, and ability to bypass traditional detection mechanisms. Deep neural networks (DNN) can process diverse and complex network data to identify novel or zero-day attacks (ZDA) that existing methods often overlook. In this research work, an advanced intrusion detection system (IDS) has been proposed based on an explainable artificial intelligence (XAI) framework. Feature attention score (FAS) guides dimensionality reduction by highlighting the most significant network attributes, ensuring the classifier focuses on related patterns. The optimal features, as identified by transition-aware FAS analysis, are selected for classification training to distinguish between normal and malicious traffic employing the benchmark NSL-KDD dataset. Experimental results demonstrate that the proposed model not only reduces feature dimensionality but also improves detection accuracy, particularly in identifying ZDA attacks. Additionally, we incorporated XAI principles by visualizing prediction confidence through a histogram of predicted probabilities and assessing reliability using a calibration plot. These visual diagnostics help interpret how the model attains its decisions, making the framework more transparent and trustworthy. The proposed model's generalizability is also verified on the benchmark CIC-IDS2017 dataset, which reveals that the proposed model is capable of identifying a diverse range of network intrusions. The generalized model is also interpretable, providing trust to humans in the decision-making process. © 2026 Elsevier B.V.},
	author_keywords = {Bidirectional LSTM; Deep neural networks; Explainable AI; Intrusion detection; Zero-day attack},
	keywords = {Classification (of information); Complex networks; Computer crime; Decision making; Dimensionality reduction; Feature extraction; Intrusion detection; Network intrusion; Zero-day attack; Attack detection; Bidirectional LSTM; Cyber security; Detection mechanism; Explainable AI; Intrusion Detection Systems; Intrusion-Detection; Network data; Neural-networks; Zero day attack; Deep neural networks},
	correspondence_address = {M.A.Z. Raja; Future Technology Research Center, National Yunlin University of Science and Technology, Douliou, 123 University Road, Section 3, Yunlin, 64002, Taiwan; email: rajamaz@yuntech.edu.tw},
	publisher = {Elsevier Ltd},
