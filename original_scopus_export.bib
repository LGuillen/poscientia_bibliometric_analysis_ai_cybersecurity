	title = {A-NIDS: Adaptive Network Intrusion Detection System Based on Clustering and Stacked CTGAN},
	year = {2025},
	journal = {IEEE Transactions on Information Forensics and Security},
	volume = {20},
	pages = {3204 - 3219},
	doi = {10.1109/TIFS.2025.3551643},
	url = {https://www.scopus.com/pages/publications/105001548033?origin=resultslist},
	affiliations = {Intelligent Computing Infrastructure Innovation Center, Zhejiang Laboratory, Zhejiang, Hangzhou, 311500, China; University of Chinese Academy of Sciences (UCAS), Beijing, 100049, China; Hangzhou Institute for Advanced Study, Ucas, School of Intelligent Science and Technology, Zhejiang, Hangzhou, 311500, China},
	abstract = {Intrusion detection systems (IDS) are crucial tools for detecting anomalous network traffic in cybersecurity. In recent years, significant progress has been made in applying artificial intelligence to IDS. However, existing research often assumes that training and testing data are static and identically distributed, whereas in reality, data drift is inevitable. Moreover, to enhance model versatility and detection performance, models have become increasingly complex, posing challenges to real-time deployment. To address these challenges, we propose an adaptive network intrusion detection system named A-NIDS, consisting of a main task and two bypass tasks. The main task is to develop a fully connected and shallow network with strong detection performance and real-time capability. The first bypass task is a clustering model that helps the main task detect data drift in an unsupervised manner. The second bypass task is a generation model to generate old data to address catastrophic forgetting in new model iterations and the storage cost issue caused by accumulating old data. We conduct extensive experiments on the CICIDS-2017 and CSE-CICIDS-2018 datasets, demonstrating the superior performance of A-NIDS on new and old data. Furthermore, our detection module achieves a detection latency of 5 microseconds, highlighting its suitability for real-time applications. All the related code is publicly available at: https://github.com/ids-sec-hub/A-NIDS. © 2005-2012 IEEE.},
	author_keywords = {adaptive; clustering; data drift; generation; Intrusion detection; latency},
	keywords = {Cybersecurity; HTTP; Intrusion detection; Adaptive; Adaptive networks; Clusterings; Data drift; Generation; Intrusion Detection Systems; Intrusion-Detection; Latency; Main tasks; Network intrusion detection systems; Network intrusion},
	correspondence_address = {R. Zhang; Intelligent Computing Infrastructure Innovation Center, Zhejiang Laboratory, Hangzhou, Zhejiang, 311500, China; email: zcor2021@gmail.com},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {15566013},
	language = {English},
	abbrev_source_title = {IEEE Trans. Inf. Forensics Secur.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 37}
}

@ARTICLE{Umar202523,
