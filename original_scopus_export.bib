	author = {Gencturk, Eren and Ustubioglu, Beste and Ulutas, Guzin and Symeonidis, Iraklis},
	title = {Class Imbalance in IoMT Datasets: Evaluating Balancing Strategies for Learning-Based Attack Detection},
	year = {2026},
