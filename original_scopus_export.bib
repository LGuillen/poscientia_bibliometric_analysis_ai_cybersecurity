@ARTICLE{Ahmad2026,
	author = {Ahmad, Sharik and Kumar, Kundan and Prakash, Amit and Shahnawaz},
	title = {Security and risk governance in AI-driven medical imaging systems: An uncertainty-aware framework},
	year = {2026},
