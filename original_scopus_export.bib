@ARTICLE{Binbeshr2025360,
	author = {Binbeshr, Farid and Imam, Muhammad and Ghaleb, Mustafa and Hamdan, Mosab and Rahim, Mussadiq Abdul and Hammoudeh, Mohammad},
	title = {The Rise of Cognitive SOCs: A Systematic Literature Review on AI Approaches},
	year = {2025},
	journal = {IEEE Open Journal of the Computer Society},
