@ARTICLE{Vostoupal2025410,
	author = {Vostoupal, Jakub},
	title = {Attributability of Acts of Autonomous Cyber-Defence Capabilities; [Mezinárodněprávní přičitatelnost aktů způsobených nasazením autonomních kapacit kybernetické obrany]},
	year = {2025},
	journal = {Pravnik},
	volume = {164},
