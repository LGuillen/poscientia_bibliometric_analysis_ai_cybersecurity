	affiliations = {Department of Information Systems, College of Computer and Information Sciences, Imam Mohammad Ibn Saud Islamic University (IMSIU), Riyadh, Saudi Arabia; Department of Computer Science, Applied College, Northern Border University, Arar, Saudi Arabia; Department of Computer Science, College of Computing and Informatics Saudi Electronic University Riyadh, Riyadh, Saudi Arabia; Department of Informatics and Computer Systems, College of Computer Science, King Khalid University, Abha, Saudi Arabia},
