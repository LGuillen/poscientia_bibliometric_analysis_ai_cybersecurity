@ARTICLE{Christian2025,
	author = {Christian, Ronil and Durgesh Babu, P. and Patel, Hrishitva and Modi, Keyur},
	title = {Building Trustworthy Autonomous AI: Essential Principles beyond Traditional Software Design},
